# ============================================================
# NEXUS AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── OpenAI ───────────────────────────────────────────────────
# Required for all AI generation. Without this, app uses mock mode.
OPENAI_API_KEY=sk-proj-...

# ── fal.ai (Flux Pro Ultra — Premium Image Generation) ───────
# Optional. When set, enables Flux 1.1 Pro Ultra as image provider.
# Flux produces superior photorealism vs gpt-image-1. ~$0.06/image.
# Get key at: https://fal.ai → API Keys
# Usage: pass { provider: 'flux' } in POST /api/visuals/generate
FAL_KEY=

# Professional five-second video masters (Runway Gen-4.5)
RUNWAYML_API_SECRET=

# ── Cloudinary (Media Uploads) ───────────────────────────────
# Both vars needed: NEXT_PUBLIC_ for client-side, plain for server-side routes
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Stripe (Billing) ────────────────────────────────
# Keep false while legal/Stripe live onboarding is still in progress.
# Set to true only after Stripe keys, products, prices, and webhooks are ready.
NEXT_PUBLIC_BILLING_ENABLED=false
# Active billing provider. Start with Stripe Test Mode and complete the full
# checkout/webhook/renewal/cancel/refund drill before replacing these with live keys.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Leave false throughout sandbox verification. A live secret key is rejected
# until this separate server-side launch approval is deliberately enabled.
BILLING_LIVE_MODE_APPROVED=false
# Create the two public subscriptions in Stripe Dashboard.
# Legacy only: keep if existing Starter subscribers still reference this price.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
# Legacy one-time packs only; do not use for new wallet checkout.
STRIPE_PRICE_CREDITS_100=price_...
STRIPE_PRICE_CREDITS_300=price_...
# Immutable one-time Stripe Prices for progressive wallet blocks. Each Price is
# per credit in USD: tier 1 = $1.00, tier 2 = $0.90, tier 3 = $0.80, tier 4 = $0.70.
STRIPE_CREDIT_WALLET_PRODUCT_ID=prod_...
STRIPE_PRICE_CREDIT_WALLET_TIER_1=price_...
STRIPE_PRICE_CREDIT_WALLET_TIER_2=price_...
STRIPE_PRICE_CREDIT_WALLET_TIER_3=price_...
STRIPE_PRICE_CREDIT_WALLET_TIER_4=price_...
# Enable only after CreditGrant/allocation and BillingWebhookEvent migrations,
# backfill, Stripe Price verification, and the complete Test Mode drill pass.
# Wallet checkout remains unavailable while this is false/unset.
CREDIT_WALLET_ENABLED=false

# ── Lead CRM ────────────────────────────────────────────────
# Enable only after both CRM migrations (Lead/Activity + Task/CaptureForm)
# succeed in Preview and workspace-isolation/deduplication tests pass.
# No email, SMS, call, or other outreach is sent automatically.
LEADS_CRM_ENABLED=false

# ── Landing pages & conversion evidence ─────────────────────
# Enable only after the landing-page migration and full public funnel pass in
# a recoverable Preview environment. LEADS_CRM_ENABLED must also be true.
LANDING_PAGES_ENABLED=false
LANDING_PAGE_EXPERIMENTS_ENABLED=false
# Independent server-only HMAC key used to pseudonymize browser event
# fingerprints. Use at least 32 random bytes; never expose as NEXT_PUBLIC_*.
CRO_EVENT_HASH_KEY=generate-an-independent-random-32-byte-secret

# ── Meta / Facebook (Social Publishing) ─────────────────────
META_APP_ID=...
META_APP_SECRET=...
META_WEBHOOK_VERIFY_TOKEN=generate-a-random-64-char-string-here
NEXT_PUBLIC_META_APP_ID=...
# Pin the Graph API version intentionally and upgrade after provider testing.
META_GRAPH_API_VERSION=v25.0

# ── Threads OAuth + Organic Publishing ─────────────────────
# Create a Meta app with the Threads use case.
# Redirect URI: https://your-domain.com/api/social/callback/threads
# Scopes: threads_basic, threads_content_publish, threads_manage_insights
THREADS_APP_ID=...
THREADS_APP_SECRET=...
# Keep DEVELOPMENT until the Meta app and required permissions are approved for public users.
THREADS_ACCESS_TIER=DEVELOPMENT

# ── TikTok OAuth ────────────────────────────────────────────
# Create app at https://developers.tiktok.com
# Scopes needed: user.info.basic, video.publish
# Do not request video.upload unless chunk upload is implemented and demonstrated.
# Redirect URI: https://your-domain.com/api/social/callback/tiktok
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...

# ── YouTube OAuth + Video Upload ────────────────────────────
# Create a Web application OAuth client in Google Cloud and enable YouTube Data API v3.
# Scopes: youtube.upload and youtube.readonly (offline access is requested for scheduled publishing).
# Redirect URI: https://your-domain.com/api/social/callback/youtube
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# NEXUS streams reviewed Cloudinary videos to YouTube; defaults to 200 MB if unset.
YOUTUBE_MAX_UPLOAD_BYTES=209715200

# ── Google Ads OAuth + Search Campaign Execution ───────────
# Use a dedicated Web application OAuth client and enable the Google Ads API.
# Redirect URI: https://your-domain.com/api/social/callback/google-ads
# OAuth scope: https://www.googleapis.com/auth/adwords
# The developer token comes from API Center in a Google Ads manager account.
# Google requires 2-Step Verification for the authenticating user.
GOOGLE_ADS_CLIENT_ID=...
GOOGLE_ADS_CLIENT_SECRET=...
GOOGLE_ADS_DEVELOPER_TOKEN=...
# Pin the tested API version. Upgrade only after provider regression testing.
GOOGLE_ADS_API_VERSION=v24
# NONE blocks execution. TEST permits provider-confirmed test accounts only.
# Use EXPLORER, BASIC, or STANDARD only after Google grants that access level.
GOOGLE_ADS_ACCESS_TIER=NONE

# ── X OAuth 2.0 + Organic Publishing ───────────────────────
# Configure a confidential Web App with callback /api/social/callback/x.
# Scopes: tweet.read tweet.write users.read media.write offline.access
X_CLIENT_ID=...
X_CLIENT_SECRET=...
# X currently limits ordinary post images to 5 MB; NEXUS never exceeds it.
X_MAX_IMAGE_BYTES=5242880

# ── Pinterest OAuth + Organic Image Pins ─────────────────────
# Configure callback: https://your-domain.com/api/social/callback/pinterest
# Scopes: boards:read, boards:write, pins:read, pins:write, user_accounts:read
PINTEREST_APP_ID=...
PINTEREST_APP_SECRET=...
# Keep TRIAL until Pinterest approves Standard access; public publishing remains locked in Trial.
PINTEREST_ACCESS_TIER=TRIAL

# ── LinkedIn OAuth ──────────────────────────────────────────
# Create app at https://www.linkedin.com/developers/apps
# Scopes needed: openid, profile, email, w_member_social
# Redirect URI: https://your-domain.com/api/social/callback/linkedin
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
# LinkedIn REST version header in YYYYMM format.
LINKEDIN_API_VERSION=202606

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Customer lifecycle messaging control plane ───────────────
# Keep disabled until the migration, Preview verification, provider approval,
# domain/number verification, and delivery webhooks are all complete.
LIFECYCLE_MESSAGING_ENABLED=false
# Server-only HMAC keys. Generate independent values with at least 32 random
# bytes; never expose them through NEXT_PUBLIC_ variables.
CONTACT_SUPPRESSION_HASH_KEY=generate-a-random-32-byte-secret
UNSUBSCRIBE_SIGNING_SECRET=generate-an-independent-random-32-byte-secret

# ── Sentry (Error Monitoring) ───────────────────────────────
# Disabled by default. Server and browser forwarding are independent: each
# runtime requires its own enabled flag plus a valid DSN.
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
# A DSN identifies the Sentry project. NEXT_PUBLIC values are bundled in the browser.
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Set these per Vercel scope (preview in Preview, production in Production).
# Leaving them blank uses VERCEL_ENV on the server and NODE_ENV as a fallback.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional public Preview/Production label when explicitly injected at build time.
NEXT_PUBLIC_VERCEL_ENV=
SENTRY_RELEASE=
# Source maps remain separately locked until org/project/auth token are verified.
SENTRY_SOURCE_MAPS_ENABLED=false
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=nexus-ai
SENTRY_AUTH_TOKEN=sntrys_...

# ── Redis (Rate Limiting / Queue) ───────────────────────────
# Optional. If not set, in-memory rate limiting is used (per-instance).
REDIS_URL=redis://...

# ── Token Encryption (Social Access Tokens) ─────────────────
# AES-256-GCM key for encrypting OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=generate-64-char-hex-here

# HMAC secret for OAuth state (Meta, LinkedIn, TikTok, YouTube, X, Pinterest). Minimum 32 chars.
# Keep separate from provider client secrets and rotate if exposed.
OAUTH_STATE_SECRET=generate-a-random-64-char-string-here

# ── Cron Security ───────────────────────────────────────────
# Random secret to protect /api/cron/* routes
CRON_SECRET=generate-a-random-string-here

# ── Webhook Security ─────────────────────────────────────────
# Secret for /api/webhooks/generation (provider push updates)
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=generate-a-random-string-here

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production
