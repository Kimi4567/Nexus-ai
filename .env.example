# Replicate API credentials
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Required model version for video generation.
# Set this to the Replicate model version ID you want to use.
REPLICATE_VIDEO_MODEL_VERSION=your_video_model_version_here

# Alternatively, set a model name and the handler will resolve its latest version.
# For text-to-video generation, use the Pika model slug:
# REPLICATE_VIDEO_MODEL=pika-ai/pika
REPLICATE_VIDEO_MODEL=your_video_model_slug_here

# Optional fallback model version variable.
# REPLICATE_MODEL_VERSION=your_video_model_version_here
# REPLICATE_MODEL=your_video_model_slug_here
