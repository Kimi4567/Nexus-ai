# Supabase
DATABASE_URL=postgresql://user:password@localhost:5432/nexus
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI
# If missing, the app will run in mock AI mode
OPENAI_API_KEY=

# Stripe
# If missing or STRIPE_MOCK=1, mock checkout will be used
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_MOCK=1

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Resend (optional)
RESEND_API_KEY=

# Analytics placeholders
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Other
NEXTAUTH_SECRET=change_me
# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_ai

# ============================================================================
# NEXTAUTH
# ============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32

# ============================================================================
# GOOGLE OAUTH (Sign in with Google)
# ============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# AI SERVICES
# ============================================================================
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# Runway ML (Video Generation)
RUNWAY_API_KEY=your-runway-api-key
RUNWAY_API_BASE=https://api.runwayml.com/v1

# ============================================================================
# STRIPE (Billing & Payments)
# ============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Pricing IDs (from Stripe dashboard)
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...

# ============================================================================
# STORAGE (Cloudinary or S3)
# ============================================================================
# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (Alternative)
AWS_S3_ACCESS_KEY_ID=your-access-key
AWS_S3_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=nexus-ai-media
AWS_S3_REGION=us-east-1

# ============================================================================
# SOCIAL INTEGRATIONS
# ============================================================================
# Meta (Facebook/Instagram)
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret

# TikTok
TIKTOK_CLIENT_KEY=your-client-key
TIKTOK_CLIENT_SECRET=your-client-secret

# YouTube
YOUTUBE_API_KEY=your-api-key
YOUTUBE_CLIENT_ID=your-client-id
YOUTUBE_CLIENT_SECRET=your-client-secret

# ============================================================================
# ENVIRONMENT
# ============================================================================
NODE_ENV=development
VERCEL_ENV=development

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
SENTRY_DSN=https://...
LOG_LEVEL=debug
REPLICATE_VIDEO_MODEL=your_video_model_slug_here

# Optional fallback model version variable.
# REPLICATE_MODEL_VERSION=your_video_model_version_here
# REPLICATE_MODEL=your_video_model_slug_here
