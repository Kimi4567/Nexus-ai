{
  "name": "nexus-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --quiet --ignore-pattern next-env.d.ts",
    "db:seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:verify-backup-restore": "node scripts/verify-database-backup-restore.mjs",
    "db:verify-marketing-migrations": "bash scripts/verify-marketing-migrations.sh",
    "billing:verify-test-mode": "node scripts/verify-stripe-test-mode.mjs",
    "billing:sync-wallet-test-prices": "node scripts/sync-stripe-wallet-test-prices.mjs",
    "credits:wallet-cutover": "node scripts/reconcile-credit-wallet-cutover.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run type-check && npm test && npm run build",
    "eval:strategy": "RUN_LIVE_STRATEGY_EVAL=1 vitest run src/lib/strategy/evals/__tests__/liveStrategyQuality.eval.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/supabase-js": "^2.106.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "1.18.1",
    "cloudinary": "^2.10.0",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.42.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mammoth": "1.12.0",
    "next": "^15.5.22",
    "prisma": "^5.7.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "satori": "^0.10.14",
    "sharp": "^0.35.3",
    "sonner": "^1.3.0",
    "stripe": "^14.0.0",
    "unpdf": "1.6.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.5.22",
    "jsdom": "^24.1.3",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "form-data": "^4.0.6",
    "fast-uri": "^3.1.4",
    "js-yaml": "^4.1.2",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
