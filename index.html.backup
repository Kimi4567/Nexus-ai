    <!-- DASHBOARD PAGE -->
    <div id="dashboard" class="page pt-20">
        <div class="flex">
            <!-- Sidebar -->
            <aside class="w-64 fixed h-full glass border-r border-white/5 hidden md:block">
                <div class="p-6">
                    <div class="mb-8">
                        <div class="text-sm text-gray-400 mb-1">Current Plan</div>
                        <div class="font-semibold text-primary-400">Free</div>
                        <div class="text-xs text-gray-500 mt-1">3/3 videos used</div>
                    </div>
                    <nav class="space-y-2">
                        <button onclick="showDashboardTab('create')" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl bg-primary-600/20 text-primary-400">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                            <span>Create Video</span>
                        </button>
                        <button onclick="showDashboardTab('videos')" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                            <span>My Videos</span>
                        </button>
                        <button onclick="showDashboardTab('analytics')" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                            <span>Analytics</span>
                        </button>
                    </nav>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 md:ml-64 p-6">
                <!-- Create Tab -->
                <div id="tab-create" class="dashboard-tab">
                    <h1 class="text-3xl font-bold mb-2">Create New Video</h1>
                    <p class="text-gray-400 mb-8">Describe your video and let AI do the magic</p>

                    <div class="glass rounded-2xl p-8 mb-8">
                        <label class="block text-sm font-medium mb-2">Video Description</label>
                        <textarea id="videoPrompt" placeholder="Example: Create a 30-second promotional video for my coffee shop..." class="w-full h-32 bg-dark-800 border border-white/10 rounded-xl p-4 text-white placeholder-gray-500 focus:outline-none focus:border-primary-500 resize-none"></textarea>

                        <div class="flex items-center justify-between mt-4">
                            <div class="text-sm text-gray-400">
                                <svg class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                Generation time: ~5 minutes
                            </div>
                            <button onclick="generateVideo()" class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-3 rounded-xl font-semibold transition flex items-center space-x-2">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                                <span>Generate Video</span>
                            </button>
                        </div>
                    </div>

                    <div id="videoResult" class="hidden glass rounded-2xl p-8 text-center">
                        <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        </div>
                        <h3 class="text-xl font-semibold mb-2">Video Generated!</h3>
                        <p class="text-gray-400 mb-4">Your video is ready for download</p>
                        <div class="w-full h-48 bg-gradient-to-br from-primary-900 to-dark-800 rounded-xl flex items-center justify-center mb-4">
                            <svg class="h-16 w-16 text-primary-400/50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                        </div>
                        <button class="bg-primary-600 hover:bg-primary-700 text-white px-6 py-3 rounded-xl font-semibold transition">Download Video</button>
                    </div>
                </div>

                <!-- Videos Tab -->
                <div id="tab-videos" class="dashboard-tab hidden">
                    <h1 class="text-3xl font-bold mb-2">My Videos</h1>
                    <p class="text-gray-400 mb-8">Manage your created videos</p>
                    <div class="space-y-4">
                        <div class="glass rounded-xl p-6 flex items-center justify-between">
                            <div class="flex items-center space-x-4">
                                <div class="w-16 h-16 bg-gradient-to-br from-primary-900 to-dark-800 rounded-lg flex items-center justify-center">
                                    <svg class="h-8 w-8 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                                </div>
                                <div>
                                    <h3 class="font-semibold">Product Launch - Summer Collection</h3>
                                    <div class="flex items-center space-x-4 text-sm text-gray-400 mt-1">
                                        <span>2026-05-20</span>
                                        <span>0:30</span>
                                        <span class="px-2 py-0.5 rounded-full text-xs bg-green-500/20 text-green-400">completed</span>
                                    </div>
                                </div>
                            </div>
                            <button class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg transition">Download</button>
                        </div>
                    </div>
                </div>

                <!-- Analytics Tab -->
                <div id="tab-analytics" class="dashboard-tab hidden">
                    <h1 class="text-3xl font-bold mb-2">Analytics</h1>
                    <p class="text-gray-400 mb-8">Track your video performance</p>
                    <div class="grid md:grid-cols-4 gap-6 mb-8">
                        <div class="glass rounded-xl p-6"><div class="text-gray-400 text-sm mb-1">Total Videos</div><div class="text-3xl font-bold">3</div></div>
                        <div class="glass rounded-xl p-6"><div class="text-gray-400 text-sm mb-1">Total Views</div><div class="text-3xl font-bold">2.1K</div></div>
                        <div class="glass rounded-xl p-6"><div class="text-gray-400 text-sm mb-1">Avg. Engagement</div><div class="text-3xl font-bold">8.4%</div></div>
                        <div class="glass rounded-xl p-6"><div class="text-gray-400 text-sm mb-1">Videos Left</div><div class="text-3xl font-bold">0/3</div></div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- LOGIN PAGE -->
    <div id="login" class="page pt-20">
        <div class="min-h-screen flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-gradient-to-b from-primary-900/20 to-transparent"></div>
            <div class="relative w-full max-w-md">
                <div class="text-center mb-8">
                    <div class="inline-flex items-center space-x-2 mb-6">
                        <svg class="h-8 w-8 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
                        <span class="text-2xl font-bold text-gradient">NEXUS AI</span>
                    </div>
                    <h1 class="text-3xl font-bold mb-2">Welcome Back</h1>
                    <p class="text-gray-400">Sign in to your account</p>
                </div>
                <div class="glass rounded-2xl p-8">
                    <form onsubmit="handleLogin(event)" class="space-y-6">
                        <div>
                            <label class="block text-sm font-medium mb-2">Email</label>
                            <input type="email" placeholder="you@company.com" class="w-full bg-dark-800 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-primary-500" required>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Password</label>
                            <input type="password" placeholder="••••••••" class="w-full bg-dark-800 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-primary-500" required>
                        </div>
                        <button type="submit" class="w-full bg-primary-600 hover:bg-primary-700 text-white py-3 rounded-xl font-semibold transition">Sign In</button>
                    </form>
                    <div class="mt-6 text-center">
                        <span class="text-gray-400">Don't have an account? </span>
                        <button onclick="showPage('register')" class="text-primary-400 hover:text-primary-300">Sign up free</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- REGISTER PAGE -->
    <div id="register" class="page pt-20">
        <div class="min-h-screen flex items-center justify-center p-4">
            <div class="absolute inset-0 bg-gradient-to-b from-primary-900/20 to-transparent"></div>
            <div class="relative w-full max-w-md">
                <div class="text-center mb-8">
                    <div class="inline-flex items-center space-x-2 mb-6">
                        <svg class="h-8 w-8 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
                        <span class="text-2xl font-bold text-gradient">NEXUS AI</span>
                    </div>
                    <h1 class="text-3xl font-bold mb-2">Get Started Free</h1>
                    <p class="text-gray-400">Create your account - no credit card required</p>
                </div>
                <div class="glass rounded-2xl p-8">
                    <form onsubmit="handleRegister(event)" class="space-y-6">
                        <div>
                            <label class="block text-sm font-medium mb-2">Full Name</label>
                            <input type="text" placeholder="John Doe" class="w-full bg-dark-800 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-primary-500" required>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Email</label>
                            <input type="email" placeholder="you@company.com" class="w-full bg-dark-800 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-primary-500" required>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Password</label>
                            <input type="password" placeholder="••••••••" class="w-full bg-dark-800 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-primary-500" required>
                        </div>
                        <button type="submit" class="w-full bg-primary-600 hover:bg-primary-700 text-white py-3 rounded-xl font-semibold transition">Create Free Account</button>
                    </form>
                    <div class="mt-6 text-center">
                        <span class="text-gray-400">Already have an account? </span>
                        <button onclick="showPage('login')" class="text-primary-400 hover:text-primary-300">Sign in</button>
                    </div>
                    <div class="mt-6 pt-6 border-t border-white/10">
                        <p class="text-xs text-gray-500 text-center">By signing up, you agree to our Terms of Service. You get 3 free videos per month.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FEATURES PAGE -->
    <div id="features" class="page pt-20">
        <section class="pt-12 pb-20">
            <div class="max-w-7xl mx-auto px-4">
                <div class="text-center mb-16">
                    <h1 class="text-5xl font-bold mb-4">Powerful Features</h1>
                    <p class="text-gray-400 text-lg">Everything you need to create stunning videos</p>
                </div>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="glass rounded-2xl p-8">
                        <svg class="h-12 w-12 text-primary-400 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                        <h3 class="text-2xl font-bold mb-3">AI Video Generation</h3>
                        <p class="text-gray-400">Create professional videos from text prompts automatically.</p>
                    </div>
                    <div class="glass rounded-2xl p-8">
                        <svg class="h-12 w-12 text-primary-400 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        <h3 class="text-2xl font-bold mb-3">Lightning Fast</h3>
                        <p class="text-gray-400">Generate videos in 5 minutes instead of 8 hours.</p>
                    </div>
                    <div class="glass rounded-2xl p-8">
                        <svg class="h-12 w-12 text-primary-400 mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                        <h3 class="text-2xl font-bold mb-3">Multi-Platform</h3>
                        <p class="text-gray-400">Optimize for TikTok, Instagram, YouTube automatically.</p>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script>
        // Page Navigation
        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
            document.getElementById(pageId).classList.add('active');
            window.scrollTo(0, 0);
        }

        // Dashboard Tabs
        function showDashboardTab(tabId) {
            document.querySelectorAll('.dashboard-tab').forEach(tab => tab.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');
        }

        // Generate Video
        function generateVideo() {
            const prompt = document.getElementById('videoPrompt').value;
            if (!prompt.trim()) return;

            const btn = event.target;
            btn.innerHTML = '<div class="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin mr-2"></div><span>Generating...</span>';
            btn.disabled = true;

            setTimeout(() => {
                document.getElementById('videoResult').classList.remove('hidden');
                btn.innerHTML = '<svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg><span>Generate Video</span>';
                btn.disabled = false;
            }, 3000);
        }

        // Login
        function handleLogin(e) {
            e.preventDefault();
            showPage('dashboard');
        }

        // Register
        function handleRegister(e) {
            e.preventDefault();
            showPage('dashboard');
        }
    </script>
</body>
</html>
