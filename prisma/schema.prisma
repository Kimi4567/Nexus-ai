// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String?
  avatar        String?
  phone         String?
  
  // Authentication
  emailVerified DateTime?
  lastLoginAt   DateTime?
  
  // Profile
  role          UserRole   @default(USER)
  industry      String?    // e.g., "ecommerce", "real_estate", "beauty"
  company       String?
  
  // Subscription
  subscriptionId     String?
  subscriptionStatus SubscriptionStatus @default(FREE)
  stripeCustomerId   String?  @unique
  aiCredits          Int @default(0)
  monthlyGenerations Int @default(0)

  // Referral system
  referralCode       String?   @unique  // this user's shareable code (e.g. NEXUS-AB12CD)
  referredById       String?            // who referred this user
  referredBy         User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals          User[]    @relation("UserReferrals")
  referralCreditsEarned Int    @default(0)  // total bonus credits earned from referrals

  // Preferences
  preferences   Json?      // theme, notifications, etc.

  // Relations
  workspaces    Workspace[]
  sessions      Session[]
  accounts      Account[]
  uploadSessions UploadSession[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([email])
  @@index([subscriptionStatus])
  @@index([referralCode])
}

model Session {
  id            String     @id @default(cuid())
  sessionToken  String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires       DateTime
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Account {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider      String     // "google", "github", etc.
  providerAccountId String
  
  accessToken   String?    @db.Text
  refreshToken  String?    @db.Text
  idToken       String?    @db.Text
  expiresAt     Int?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================================================
// WORKSPACES & PROJECTS
// ============================================================================

model Workspace {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  logo          String?
  description   String?
  
  // Owner
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Team
  members       WorkspaceMember[]
  
  // Content
  projects      Project[]
  media         Media[]
  campaigns     Campaign[]
  uploadSessions UploadSession[]
  exports       Export[]
  integrations  Integration[]
  brandProfile  BrandProfile?
  visuals       GeneratedVisual[]
  socialPosts   SocialPost[]
  agentRuns     AgentRun[]
  agentSuggestions AgentSuggestion[]
  agentReports  AgentReport[]

  // Settings
  settings      Json?      // branding, integrations, etc.
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([ownerId])
  @@index([slug])
}

model WorkspaceMember {
  id            String     @id @default(cuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  userId        String     // Email or actual user ID
  role          MemberRole @default(MEMBER)
  
  invitedAt     DateTime   @default(now())
  joinedAt      DateTime?
  
  @@unique([workspaceId, userId])
}

model Project {
  id            String     @id @default(cuid())
  name          String
  description   String?
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Business Info
  businessType  String?    // "restaurant", "ecommerce", "salon", etc.
  businessInfo  Json?      // { name, description, targetAudience, etc. }
  
  // Media
  media         Media[]
  uploadSessions UploadSession[]
  
  // Campaigns
  campaigns     Campaign[]
  
  // Status
  status        ProjectStatus @default(DRAFT)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([workspaceId])
  @@index([status])
}

// ============================================================================
// MEDIA & UPLOADS
// ============================================================================

model Media {
  id            String     @id @default(cuid())
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  fileName      String
  type          MediaType  // "image", "video", "logo", "audio"
  mimeType      String
  
  // Storage
  url           String     // Cloudinary or S3 URL
  cloudinaryId  String?
  s3Key         String?
  
  // Metadata
  width         Int?
  height        Int?
  duration      Int?       // For videos, in seconds
  size          Int        // File size in bytes
  
  // Tagging
  tags          String[]   @default([])
  category      String?    // "product", "lifestyle", "logo", etc.
  
  // Usage
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  uploadSessionId String?
  uploadSession UploadSession? @relation(fields: [uploadSessionId], references: [id], onDelete: SetNull)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([type])
  @@index([campaignId])
  @@index([uploadSessionId])
}

model UploadSession {
  id            String     @id @default(cuid())
  token         String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      Campaign?  @relation("CampaignUploadSessions", fields: [campaignId], references: [id], onDelete: SetNull)
  resourceType  String?
  fileName      String?
  media         Media[]
  expiresAt     DateTime
  usedAt        DateTime?
  status        UploadSessionStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([campaignId])
  @@index([token])
}

model UploadAudit {
  id            String     @id @default(cuid())
  userId        String?
  workspaceId   String?
  projectId     String?
  sessionId     String?
  eventType     String
  severity      String     @default("INFO")
  ip            String?
  metadata      Json?
  createdAt     DateTime   @default(now())
}

enum UploadSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

// ============================================================================
// CAMPAIGNS & GENERATIONS
// ============================================================================

model Campaign {
  id            String     @id @default(cuid())
  name          String
  description   String?
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Campaign Configuration
  goal          CampaignGoal   // "sales", "awareness", "leads", "traffic"
  audience      String?        // Audience description
  tone          BrandTone      // "luxury", "modern", "energetic", etc.
  platforms     Platform[]     // ["tiktok", "instagram", "facebook"]
  
  // Media used
  media         Media[]
  
  // AI Strategy
  strategy      Json?          // AI-generated marketing strategy
  concepts      AdConcept[]    // Generated concepts
  analytics     Analytics?     @relation("AnalyticsToCampaign")
  uploadSessions UploadSession[] @relation("CampaignUploadSessions")
  
  // Generations
  generations   Generation[]
  
  // Full AI output stored for history/detail view
  aiOutput      Json?          // { strategy, concepts, generatedAt }

  // User interactions
  favorite      Boolean        @default(false)
  lastViewedAt  DateTime?
  thumbnail     String?        // emoji or hex color for visual identity

  // Activity timeline
  activities    CampaignActivity[]
  visuals       GeneratedVisual[]

  // Performance
  status        CampaignStatus @default(DRAFT)
  publishedAt   DateTime?
  performanceMetrics Json?     // views, clicks, conversions

  // Sharing
  shareToken    String?        @unique  // random token for public URL
  isPublic      Boolean        @default(false)
  shareViews    Int            @default(0)

  // Autopilot
  autopilotEnabled   Boolean   @default(false)
  autopilotActivatedAt DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@index([favorite])
  @@index([lastViewedAt])
  @@index([shareToken])
}

model CampaignActivity {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        String   // "created", "generated", "viewed", "regenerated", "exported", "duplicated", "archived", "favorited"
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([campaignId])
  @@index([createdAt])
}

model AdConcept {
  id            String     @id @default(cuid())
  campaignId    String
  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  name          String
  description   String
  angle         String     // Marketing angle / hook
  
  script        String?    // Ad script
  cta           String?    // Call-to-action
  headlines     String[]   // Multiple headline variations
  captions      String[]   // Platform-specific captions
  
  // AI generated
  thinking      String?    // Claude's thinking process
  
  // Status
  approved      Boolean    @default(false)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([campaignId])
}

model Generation {
  id            String     @id @default(cuid())
  campaignId    String
  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  type          GenerationType  // "video", "image", "audio", "post"
  platform      Platform?       // "tiktok", "instagram", etc.
  
  // Generation Config
  prompt        String     @db.Text
  params        Json?      // dimensions, duration, style, etc.
  
  // Status
  status        GenerationStatus @default(PENDING)
  progress      Int @default(0)   // 0-100
  
  // Results
  output        String?    // URL to generated content
  metadata      Json?      // width, height, duration, etc.
  
  // Provider
  provider      String?    // "runway", "replicate", "openai", etc.
  externalId    String?    // Provider's job/prediction ID
  
  // Error handling
  error         String?
  retries       Int @default(0)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([campaignId])
  @@index([status])
  @@index([provider])
}

// ============================================================================
// SUBSCRIPTIONS & BILLING
// ============================================================================

model Subscription {
  id            String     @id @default(cuid())
  
  userId        String     @unique
  
  plan          PricingPlan     // "starter", "pro", "agency"
  status        SubscriptionStatus
  
  stripeId      String?    @unique
  customerId    String?    // Stripe customer ID
  
  // Pricing
  amount        Int?       // in cents
  currency      String     @default("usd")
  billingCycle  BillingCycle @default(MONTHLY)
  
  // Limits
  monthlyCredits     Int
  monthlyExports     Int
  maxTeamMembers     Int
  
  // Dates
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt    DateTime?
  
  // Extra
  metadata      Json?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Usage {
  id            String     @id @default(cuid())
  
  userId        String
  month         Int        // Month (1-12)
  year          Int        // Year
  
  aiCreditsUsed Int @default(0)
  generationsCount Int @default(0)
  exportsCount  Int @default(0)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@unique([userId, month, year])
}

// ============================================================================
// ANALYTICS & EXPORTS
// ============================================================================

model Export {
  id            String     @id @default(cuid())
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  campaignId    String?    // Optional if exporting multiple
  
  format        ExportFormat   // "pdf", "video", "images", "zip"
  type          String         // "full_campaign", "social_posts", "video_package"
  
  url           String?        // Download URL
  status        ExportStatus   @default(PROCESSING)
  
  // Metadata
  fileSize      Int?           // in bytes
  itemsCount    Int @default(1)
  
  createdAt     DateTime   @default(now())
  completedAt   DateTime?
  expiresAt     DateTime?      // When download link expires
  
  @@index([workspaceId])
}

model Analytics {
  id            String     @id @default(cuid())
  
  campaignId    String     @unique
  campaign      Campaign   @relation("AnalyticsToCampaign", fields: [campaignId], references: [id], onDelete: Cascade)
  
  // Social platform stats
  platform      Platform
  
  views         Int @default(0)
  clicks        Int @default(0)
  conversions   Int @default(0)
  shares        Int @default(0)
  comments      Int @default(0)
  
  // Metrics
  ctr           Float?     // Click-through rate
  conversionRate Float?    // Conversion rate
  cost          Float?     // In campaign currency
  roi           Float?
  
  // Time
  trackedFrom   DateTime
  trackedTo     DateTime
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([campaignId])
}

// ============================================================================
// BRAND INTELLIGENCE
// ============================================================================

model BrandProfile {
  id            String     @id @default(cuid())

  workspaceId   String     @unique
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Core brand identity
  brandName     String?
  industry      String?
  description   String?    @db.Text

  // Voice & tone memory
  toneKeywords  String[]   @default([])  // e.g., ["bold", "conversational", "premium"]
  avoidKeywords String[]   @default([])  // words/styles to avoid
  writingStyle  String?    // "short punchy", "long-form storytelling", etc.

  // Audience memory
  targetAudience    String?    @db.Text
  audienceAge       String?    // "18-24", "25-34", "35-54", etc.
  audienceLocation  String?
  audiencePainPoints String[]  @default([])
  audienceDesires   String[]   @default([])

  // Offer memory
  primaryOffer  String?    @db.Text
  secondaryOffers String[] @default([])
  pricePoint    String?    // "budget", "mid-range", "premium", "luxury"
  uniqueAdvantages String[] @default([])

  // Visual style memory
  visualStyle   String?    // "minimalist", "bold", "lifestyle", "corporate"
  colorPalette  String[]   @default([])  // hex values or color names
  logoUrl       String?

  // Campaign performance memory
  winningHooks  String[]   @default([])  // hooks that worked
  winningAngles String[]   @default([])  // angles that converted
  failedAngles  String[]   @default([])  // what didn't work
  topPlatforms  String[]   @default([])  // best-performing platforms

  // Strategic notes (freeform memory)
  strategicNotes String?   @db.Text
  competitorNotes String?  @db.Text

  // AI-generated insights (auto-populated)
  aiInsights    Json?      // { summary, recommendations, lastUpdated }

  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  @@index([workspaceId])
}

// ============================================================================
// INTEGRATIONS
// ============================================================================

model Integration {
  id            String     @id @default(cuid())
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  type          IntegrationType    // "meta", "tiktok", "youtube", "stripe"
  status        IntegrationStatus  @default(DISCONNECTED)
  
  // Credentials
  accessToken   String?    @db.Text
  refreshToken  String?    @db.Text
  accountId     String?
  accountName   String?
  
  // Config
  config        Json?
  
  lastSyncedAt  DateTime?

  // Published posts via this integration
  socialPosts   SocialPost[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([workspaceId, type])
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  USER
  GUEST
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  LOGO
  AUDIO
}

enum CampaignGoal {
  SALES
  AWARENESS
  LEADS
  TRAFFIC
  ENGAGEMENT
  BRAND_BUILDING
}

enum BrandTone {
  LUXURY
  MODERN
  ENERGETIC
  CORPORATE
  MINIMAL
  AGGRESSIVE_SALES
  FRIENDLY
  PROFESSIONAL
}

enum Platform {
  TIKTOK
  INSTAGRAM
  FACEBOOK
  YOUTUBE_SHORTS
  SNAPCHAT
  LINKEDIN
  TWITTER
  WEBSITE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GenerationType {
  VIDEO
  IMAGE
  AUDIO
  SOCIAL_POST
  THUMBNAIL
  STORYBOARD
}

enum GenerationStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PricingPlan {
  STARTER
  PRO
  AGENCY
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum ExportFormat {
  PDF
  VIDEO
  IMAGES
  ZIP
  JSON
}

enum ExportStatus {
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum IntegrationType {
  META
  LINKEDIN
  TIKTOK
  YOUTUBE
  GOOGLE
  STRIPE
  CLOUDINARY
  SLACK
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

// ============================================================================
// SOCIAL PUBLISHING
// ============================================================================

model SocialPost {
  id            String     @id @default(cuid())

  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId    String?

  // Which integration / page this was published to
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  platform      IntegrationType   // META, TIKTOK, etc.
  pageId        String?           // Facebook page ID or IG account ID
  pageName      String?

  // Content
  caption       String     @db.Text
  imageUrl      String?    // Optional attached image
  link          String?    // Optional link in post

  // Platform result
  platformPostId String?   // ID returned by the platform after publishing
  platformUrl   String?    // Direct URL to the post

  // Status
  status        SocialPostStatus @default(DRAFT)
  errorMessage  String?

  scheduledAt   DateTime?
  publishedAt   DateTime?

  // Autopilot fields
  imagePrompt   String?    @db.Text  // prompt for auto image generation
  autoGenerated Boolean    @default(false)   // created by Autopilot
  weekNumber    Int?       // which strategy week (1–4)

  // Media Intelligence (Sprint AF)
  sourceType    String?    @default("AI_GENERATED")  // "AI_GENERATED" | "USER_ASSET" | "NONE"
  sourceMediaId String?    // ID of the Media record used as visual

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([workspaceId])
  @@index([campaignId])
  @@index([integrationId])
  @@index([status])
  @@index([autoGenerated])
}

// ============================================================================
// AGENT SYSTEM
// ============================================================================

enum AgentType {
  STRATEGIST
  CONTENT_DIRECTOR
  CAMPAIGN_MANAGER
  REPORTING
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

enum SuggestionType {
  STRATEGY          // New campaign strategy
  CONTENT_SWAP      // Replace/refresh content
  BUDGET_CHANGE     // Increase/decrease budget
  AUDIENCE_SHIFT    // Change targeting
  PLATFORM_ADD      // Add new platform
  PLATFORM_PAUSE    // Pause underperforming platform
  CAMPAIGN_PAUSE    // Pause campaign
  CAMPAIGN_LAUNCH   // Launch new campaign
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
}

model AgentRun {
  id            String        @id @default(cuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agent         AgentType
  status        AgentRunStatus @default(RUNNING)
  triggeredBy   String?       // "cron", "user", "auto"

  inputData     Json?         // what the agent received
  outputData    Json?         // what the agent produced
  error         String?

  durationMs    Int?
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  suggestions   AgentSuggestion[]
  reports       AgentReport[]

  @@index([workspaceId])
  @@index([agent])
  @@index([status])
  @@index([createdAt])
}

model AgentSuggestion {
  id            String           @id @default(cuid())
  workspaceId   String
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentRunId    String?
  agentRun      AgentRun?        @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  agent         AgentType
  type          SuggestionType
  status        SuggestionStatus @default(PENDING)

  // Human-readable summary
  title         String           // "CTR dropped 22% — Swap audience"
  reasoning     String           @db.Text  // Why the agent recommends this
  impact        String?          // "Expected: +15% CTR"

  // Structured action payload (agent-type specific)
  payload       Json             // { action, params }

  // Optional campaign link
  campaignId    String?

  // Approval tracking
  approvedAt    DateTime?
  rejectedAt    DateTime?
  executedAt    DateTime?
  executionResult Json?

  // Urgency
  priority      Int @default(2)  // 1=urgent, 2=normal, 3=low
  expiresAt     DateTime?        // suggestion expires if not acted on

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([agent])
  @@index([priority])
  @@index([createdAt])
}

model AgentReport {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentRunId    String?
  agentRun      AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  type          ReportType
  title         String       // "Weekly Performance — May 20–26"
  summary       String       @db.Text  // 2-3 sentence exec summary
  body          Json         // { metrics, insights, recommendations, highlights }

  // Period
  periodStart   DateTime
  periodEnd     DateTime

  // Optional campaign scope
  campaignId    String?

  // Email sent?
  emailedAt     DateTime?

  createdAt     DateTime     @default(now())

  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// VISUAL GENERATION
// ============================================================================

enum VisualStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  ARCHIVED
}

enum VisualType {
  HERO
  SOCIAL_PREVIEW
  AD_CREATIVE
  THUMBNAIL
  ALTERNATE
}

model GeneratedVisual {
  id              String       @id @default(cuid())

  // Ownership
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Visual configuration
  visualType      VisualType   @default(HERO)
  visualStyle     String       // Minimal, Luxury, Editorial, Cinematic, etc.
  prompt          String       @db.Text  // user-facing creative direction
  enhancedPrompt  String?      @db.Text  // full prompt sent to DALL-E

  // Campaign context snapshot (preserved at generation time)
  campaignName    String?
  campaignGoal    String?
  campaignTone    String?
  audience        String?      @db.Text

  // Brand context snapshot
  brandName       String?
  brandToneWords  String[]     @default([])

  // Generation state
  status          VisualStatus @default(PENDING)
  imageUrl        String?      // permanent Cloudinary URL
  thumbnailUrl    String?
  errorMessage    String?
  retryCount      Int          @default(0)

  // Metadata
  isPrimary       Boolean      @default(false)
  isArchived      Boolean      @default(false)
  version         Int          @default(1)
  parentId        String?      // links regenerations to original

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([workspaceId])
  @@index([campaignId])
  @@index([status])
}

// ============================================================================
// RATE LIMITING (production-grade, cross-instance)
// ============================================================================

// Stores per-key sliding-window counters in Postgres.
// One row per rate-limit key (e.g. "ai:userId", "chat:userId", "checkout:userId").
// The API layer resets count when windowStart is older than the window duration.
// Run `npx prisma db push` after deploying to activate.
model RateLimitRecord {
  id          String   @id @default(cuid())
  key         String   @unique           // composite key: "scope:identifier"
  windowStart DateTime                   // start of the current window
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([updatedAt])
}
