// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String?
  avatar        String?
  phone         String?
  
  // Authentication
  emailVerified DateTime?
  lastLoginAt   DateTime?
  
  // Profile
  role          UserRole   @default(USER)
  industry      String?    // e.g., "ecommerce", "real_estate", "beauty"
  company       String?
  
  // Subscription
  subscriptionId     String?
  subscriptionStatus SubscriptionStatus @default(FREE)
  stripeCustomerId   String?  @unique
  aiCredits          Int @default(0)
  monthlyGenerations Int @default(0)

  // Referral system
  referralCode       String?   @unique  // this user's shareable code (e.g. NEXUS-AB12CD)
  referredById       String?            // who referred this user
  referredBy         User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals          User[]    @relation("UserReferrals")
  referralCreditsEarned Int    @default(0)  // total bonus credits earned from referrals

  // Preferences
  preferences   Json?      // theme, notifications, etc.

  // Relations
  workspaces    Workspace[]
  sessions      Session[]
  accounts      Account[]
  uploadSessions UploadSession[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([email])
  @@index([subscriptionStatus])
  @@index([referralCode])
}

model Session {
  id            String     @id @default(cuid())
  sessionToken  String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires       DateTime
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Account {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider      String     // "google", "github", etc.
  providerAccountId String
  
  accessToken   String?    @db.Text
  refreshToken  String?    @db.Text
  idToken       String?    @db.Text
  expiresAt     Int?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================================================
// WORKSPACES & PROJECTS
// ============================================================================

model Workspace {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  logo          String?
  description   String?
  
  // Owner
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Team
  members       WorkspaceMember[]
  
  // Content
  projects      Project[]
  media         Media[]
  campaigns     Campaign[]
  uploadSessions UploadSession[]
  exports       Export[]
  integrations  Integration[]
  brandProfile  BrandProfile?
  visuals       GeneratedVisual[]
  socialPosts   SocialPost[]
  agentRuns     AgentRun[]
  agentSuggestions AgentSuggestion[]
  agentReports  AgentReport[]
  paidPacks     PaidCampaignPack[]
  campaignMemories CampaignMemory[]
  brainLearnings   BrainLearning[]
  brainScoreSnapshots BrainScoreSnapshot[]
  adAccounts    AdAccount[]
  adCampaigns   AdCampaign[]

  // Settings
  settings      Json?      // branding, integrations, etc.

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([ownerId])
  @@index([slug])
}

model WorkspaceMember {
  id            String     @id @default(cuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  userId        String     // Email or actual user ID
  role          MemberRole @default(MEMBER)
  
  invitedAt     DateTime   @default(now())
  joinedAt      DateTime?
  
  @@unique([workspaceId, userId])
}

model Project {
  id            String     @id @default(cuid())
  name          String
  description   String?
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Business Info
  businessType  String?    // "restaurant", "ecommerce", "salon", etc.
  businessInfo  Json?      // { name, description, targetAudience, etc. }
  
  // Media
  media         Media[]
  uploadSessions UploadSession[]
  
  // Campaigns
  campaigns     Campaign[]
  
  // Status
  status        ProjectStatus @default(DRAFT)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([workspaceId])
  @@index([status])
}

// ============================================================================
// MEDIA & UPLOADS
// ============================================================================

model Media {
  id            String     @id @default(cuid())
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  fileName      String
  type          MediaType  // "image", "video", "logo", "audio"
  mimeType      String
  
  // Storage
  url           String     // Cloudinary or S3 URL
  cloudinaryId  String?
  s3Key         String?
  
  // Metadata
  width         Int?
  height        Int?
  duration      Int?       // For videos, in seconds
  size          Int        // File size in bytes
  
  // Tagging
  tags          String[]   @default([])
  category      String?    // "product", "lifestyle", "logo", etc.
  
  // Usage
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  uploadSessionId String?
  uploadSession UploadSession? @relation(fields: [uploadSessionId], references: [id], onDelete: SetNull)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([type])
  @@index([campaignId])
  @@index([uploadSessionId])
}

model UploadSession {
  id            String     @id @default(cuid())
  token         String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  campaignId    String?
  campaign      Campaign?  @relation("CampaignUploadSessions", fields: [campaignId], references: [id], onDelete: SetNull)
  resourceType  String?
  fileName      String?
  media         Media[]
  expiresAt     DateTime
  usedAt        DateTime?
  status        UploadSessionStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([campaignId])
  @@index([token])
}

model UploadAudit {
  id            String     @id @default(cuid())
  userId        String?
  workspaceId   String?
  projectId     String?
  sessionId     String?
  eventType     String
  severity      String     @default("INFO")
  ip            String?
  metadata      Json?
  createdAt     DateTime   @default(now())
}

enum UploadSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

// ============================================================================
// CAMPAIGNS & GENERATIONS
// ============================================================================

model Campaign {
  id            String     @id @default(cuid())
  name          String
  description   String?
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Campaign Configuration
  goal          CampaignGoal   // "sales", "awareness", "leads", "traffic"
  audience      String?        // Audience description
  tone          BrandTone      // "luxury", "modern", "energetic", etc.
  platforms     Platform[]     // ["tiktok", "instagram", "facebook"]
  
  // Media used
  media         Media[]
  
  // AI Strategy
  strategy      Json?          // AI-generated marketing strategy
  concepts      AdConcept[]    // Generated concepts
  analytics     Analytics?     @relation("AnalyticsToCampaign")
  uploadSessions UploadSession[] @relation("CampaignUploadSessions")
  
  // Generations
  generations   Generation[]
  
  // Full AI output stored for history/detail view
  aiOutput      Json?          // { strategy, concepts, generatedAt }

  // User interactions
  favorite      Boolean        @default(false)
  lastViewedAt  DateTime?
  thumbnail     String?        // emoji or hex color for visual identity

  // Activity timeline
  activities    CampaignActivity[]
  visuals       GeneratedVisual[]

  // Performance
  status        CampaignStatus @default(DRAFT)
  publishedAt   DateTime?
  performanceMetrics Json?     // views, clicks, conversions

  // Sharing
  shareToken    String?        @unique  // random token for public URL
  isPublic      Boolean        @default(false)
  shareViews    Int            @default(0)

  // Autopilot
  autopilotEnabled   Boolean   @default(false)
  autopilotActivatedAt DateTime?

  // Paid Campaign Pack (one per campaign)
  paidPack      PaidCampaignPack?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@index([favorite])
  @@index([lastViewedAt])
  @@index([shareToken])
  @@index([updatedAt])   // dashboard recent-campaigns ordering
}

model CampaignActivity {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        String   // "created", "generated", "viewed", "regenerated", "exported", "duplicated", "archived", "favorited"
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([campaignId])
  @@index([createdAt])
}

model AdConcept {
  id            String     @id @default(cuid())
  campaignId    String
  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  name          String
  description   String
  angle         String     // Marketing angle / hook
  
  script        String?    // Ad script
  cta           String?    // Call-to-action
  headlines     String[]   // Multiple headline variations
  captions      String[]   // Platform-specific captions
  
  // AI generated
  thinking      String?    // Claude's thinking process
  
  // Status
  approved      Boolean    @default(false)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([campaignId])
}

model Generation {
  id            String     @id @default(cuid())
  campaignId    String
  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  type          GenerationType  // "video", "image", "audio", "post"
  platform      Platform?       // "tiktok", "instagram", etc.
  
  // Generation Config
  prompt        String     @db.Text
  params        Json?      // dimensions, duration, style, etc.
  
  // Status
  status        GenerationStatus @default(PENDING)
  progress      Int @default(0)   // 0-100
  
  // Results
  output        String?    // URL to generated content
  metadata      Json?      // width, height, duration, etc.
  
  // Provider
  provider      String?    // "runway", "replicate", "openai", etc.
  externalId    String?    // Provider's job/prediction ID
  
  // Error handling
  error         String?
  retries       Int @default(0)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([campaignId])
  @@index([status])
  @@index([provider])
}

// ============================================================================
// SUBSCRIPTIONS & BILLING
// ============================================================================

model Subscription {
  id            String     @id @default(cuid())
  
  userId        String     @unique
  
  plan          PricingPlan     // "starter", "pro", "agency"
  status        SubscriptionStatus
  
  stripeId      String?    @unique
  customerId    String?    // Stripe customer ID
  
  // Pricing
  amount        Int?       // in cents
  currency      String     @default("usd")
  billingCycle  BillingCycle @default(MONTHLY)
  
  // Limits
  monthlyCredits     Int
  monthlyExports     Int
  maxTeamMembers     Int
  
  // Dates
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt    DateTime?
  
  // Extra
  metadata      Json?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Usage {
  id            String     @id @default(cuid())
  
  userId        String
  month         Int        // Month (1-12)
  year          Int        // Year
  
  aiCreditsUsed Int @default(0)
  generationsCount Int @default(0)
  exportsCount  Int @default(0)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@unique([userId, month, year])
}

// ── Credit Transaction Log ────────────────────────────────────────────────────
// Immutable audit trail. Every deduction and refund writes a row here.
// Negative amount = credits consumed. Positive amount = credits added/refunded.
model CreditTransaction {
  id          String   @id @default(cuid())

  userId      String

  // Action key matches CREDIT_COSTS or "REFUND" / "BONUS"
  action      String
  // Human-readable label shown in the credit history UI
  description String?

  // Signed amount: negative = spent, positive = earned/refunded
  amount      Int

  // Optional link to the entity this credit was spent on
  entityId    String?   // campaignId, imageId, etc.
  entityType  String?   // "campaign", "image", "strategy", "refund"

  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// ============================================================================
// ANALYTICS & EXPORTS
// ============================================================================

model Export {
  id            String     @id @default(cuid())
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  campaignId    String?    // Optional if exporting multiple
  
  format        ExportFormat   // "pdf", "video", "images", "zip"
  type          String         // "full_campaign", "social_posts", "video_package"
  
  url           String?        // Download URL
  status        ExportStatus   @default(PROCESSING)
  
  // Metadata
  fileSize      Int?           // in bytes
  itemsCount    Int @default(1)
  
  createdAt     DateTime   @default(now())
  completedAt   DateTime?
  expiresAt     DateTime?      // When download link expires
  
  @@index([workspaceId])
}

model Analytics {
  id            String     @id @default(cuid())
  
  campaignId    String     @unique
  campaign      Campaign   @relation("AnalyticsToCampaign", fields: [campaignId], references: [id], onDelete: Cascade)
  
  // Social platform stats
  platform      Platform
  
  views         Int @default(0)
  clicks        Int @default(0)
  conversions   Int @default(0)
  shares        Int @default(0)
  comments      Int @default(0)
  
  // Metrics
  ctr           Float?     // Click-through rate
  conversionRate Float?    // Conversion rate
  cost          Float?     // In campaign currency
  roi           Float?
  
  // Time
  trackedFrom   DateTime
  trackedTo     DateTime
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([campaignId])
}

// ============================================================================
// BRAND INTELLIGENCE
// ============================================================================

model BrandProfile {
  id            String     @id @default(cuid())

  workspaceId   String     @unique
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Core brand identity
  brandName     String?
  industry      String?
  description   String?    @db.Text

  // Voice & tone memory
  toneKeywords  String[]   @default([])  // e.g., ["bold", "conversational", "premium"]
  avoidKeywords String[]   @default([])  // words/styles to avoid
  writingStyle  String?    // "short punchy", "long-form storytelling", etc.

  // Audience memory
  targetAudience    String?    @db.Text
  audienceAge       String?    // "18-24", "25-34", "35-54", etc.
  audienceLocation  String?
  audiencePainPoints String[]  @default([])
  audienceDesires   String[]   @default([])

  // Offer memory
  primaryOffer  String?    @db.Text
  secondaryOffers String[] @default([])
  pricePoint    String?    // "budget", "mid-range", "premium", "luxury"
  uniqueAdvantages String[] @default([])

  // Visual style memory
  visualStyle   String?    // "minimalist", "bold", "lifestyle", "corporate"
  colorPalette  String[]   @default([])  // hex values or color names
  logoUrl       String?

  // Campaign performance memory
  winningHooks  String[]   @default([])  // hooks that worked
  winningAngles String[]   @default([])  // angles that converted
  failedAngles  String[]   @default([])  // what didn't work
  topPlatforms  String[]   @default([])  // best-performing platforms

  // Competitor intelligence
  competitors     String[]  @default([])   // list of competitor names for daily monitoring
  competitorNotes String?   @db.Text       // freeform notes about competitive landscape

  // Strategic notes (freeform memory)
  strategicNotes String?   @db.Text

  // Website & content intelligence (auto-scanned)
  websiteUrl    String?                          // brand's main website URL
  contentSamples String[]  @default([])          // up to 3 pasted best-performing content pieces

  // AI-generated insights (auto-populated)
  aiInsights    Json?      // { summary, recommendations, lastUpdated }

  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  @@index([workspaceId])
}

// ============================================================================
// INTEGRATIONS
// ============================================================================

model Integration {
  id            String     @id @default(cuid())
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  type          IntegrationType    // "meta", "tiktok", "youtube", "stripe"
  status        IntegrationStatus  @default(DISCONNECTED)
  
  // Credentials
  accessToken   String?    @db.Text
  refreshToken  String?    @db.Text
  accountId     String?
  accountName   String?
  
  // Config
  config        Json?
  
  lastSyncedAt  DateTime?

  // Published posts via this integration
  socialPosts   SocialPost[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([workspaceId, type])
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  USER
  GUEST
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  LOGO
  AUDIO
}

enum CampaignGoal {
  SALES
  AWARENESS
  LEADS
  TRAFFIC
  ENGAGEMENT
  BRAND_BUILDING
}

enum BrandTone {
  LUXURY
  MODERN
  ENERGETIC
  CORPORATE
  MINIMAL
  AGGRESSIVE_SALES
  FRIENDLY
  PROFESSIONAL
}

enum Platform {
  TIKTOK
  INSTAGRAM
  FACEBOOK
  YOUTUBE_SHORTS
  SNAPCHAT
  LINKEDIN
  TWITTER
  WEBSITE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GenerationType {
  VIDEO
  IMAGE
  AUDIO
  SOCIAL_POST
  THUMBNAIL
  STORYBOARD
}

enum GenerationStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PricingPlan {
  STARTER
  PRO
  AGENCY
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum ExportFormat {
  PDF
  VIDEO
  IMAGES
  ZIP
  JSON
}

enum ExportStatus {
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum IntegrationType {
  META
  LINKEDIN
  TIKTOK
  YOUTUBE
  GOOGLE
  STRIPE
  CLOUDINARY
  SLACK
}

enum SocialPostStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

// Publishing Sprint PR1 — distinguishes hand-publishing (MANUAL) from real-API
// auto-publishing (AUTO). Default MANUAL so existing/legacy posts never claim a
// platform published them. The publish cron must later filter publishMode = AUTO.
enum PublishMode {
  MANUAL
  AUTO
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

// ============================================================================
// SOCIAL PUBLISHING
// ============================================================================

model SocialPost {
  id            String     @id @default(cuid())

  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId    String?

  // Which integration / page this was published to
  // integrationId is optional: NULL means the post is in the content plan
  // but not yet linked to a connected platform account.
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  platform      IntegrationType   // META, TIKTOK, etc.
  pageId        String?           // Facebook page ID or IG account ID
  pageName      String?

  // Content
  caption       String     @db.Text
  imageUrl      String?    // Final generated/uploaded image URL
  link          String?    // Optional link in post

  // Platform result
  platformPostId String?   // ID returned by the platform after publishing
  platformUrl   String?    // Direct URL to the post

  // Status
  status        SocialPostStatus @default(DRAFT)
  errorMessage  String?

  scheduledAt   DateTime?
  publishedAt   DateTime?

  // Publishing lifecycle (Publishing Sprint PR1) — additive, backward-compatible.
  // No behaviour change for existing rows: publishMode defaults to MANUAL and both
  // timestamps are nullable. Lifecycle: DRAFT → APPROVED → SCHEDULED → PUBLISHED | FAILED.
  publishMode         PublishMode @default(MANUAL)
  approvedAt          DateTime?   // when DRAFT → APPROVED
  manuallyPublishedAt DateTime?   // when the user confirmed they published it by hand
  statusHistory       PostStatusHistory[]

  // Autopilot fields
  imagePrompt   String?    @db.Text  // prompt for auto image generation
  autoGenerated Boolean    @default(false)   // created by Autopilot
  weekNumber    Int?       // which strategy week (1–4)

  // Media Intelligence (Sprint AF)
  sourceType    String?    @default("AI_GENERATED")  // "AI_GENERATED" | "USER_ASSET" | "NONE"
  sourceMediaId String?    // ID of the Media record used as visual

  // Content Hub fields (Sprint CH)
  isVideoPost       Boolean  @default(false)              // true = this slot is a video
  videoPrompt       String?  @db.Text                     // Replicate prompt for video gen
  generationStatus  String   @default("PENDING")          // PENDING | GENERATING | DONE | FAILED | SKIPPED
  mediaSource       String   @default("GENERATE")         // GENERATE | UPLOAD | MIXED
  uploadedMediaId   String?                               // user's own uploaded asset (Media.id)
  contentPlanIndex  Int?                                  // position in the monthly content plan (1-N)

  // A/B Testing (Sprint FL2-E)
  variantGroup      String?                               // shared ID linking A + B variants
  variantLabel      String?  @default("A")                // "A" | "B"
  variantWinner     Boolean  @default(false)              // true = this was the winning variant

  // Post Analytics (Sprint FL2-B) — populated by cron/fetch-analytics
  analyticsData     Json?    // { likes, comments, shares, impressions, reach, engagementRate }
  analyticsUpdatedAt DateTime?
  analyticsFetched  Boolean  @default(false)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([workspaceId])
  @@index([campaignId])
  @@index([integrationId])
  @@index([status])
  @@index([autoGenerated])
  @@index([variantGroup])          // A/B testing — findFirst/findMany by variantGroup
  @@index([scheduledAt])           // publish cron: find posts due for publishing
  @@index([status, scheduledAt])   // composite: WHERE status='SCHEDULED' AND scheduledAt<=NOW()
  @@index([publishMode])           // future: cron filters publishMode = AUTO
}

// Publishing Sprint PR1 — append-only audit trail of post lifecycle transitions.
// One row per status change, written by the status-transition helper. Powers honest
// UX ("Published manually by you on …") and debugging. Purely additive.
model PostStatusHistory {
  id            String     @id @default(cuid())

  socialPostId  String
  socialPost    SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  workspaceId   String

  fromStatus    String?    // previous status (null for the first record)
  toStatus      String     // new status after the transition
  actor         String     @default("USER")   // USER | SYSTEM | CRON
  note          String?    @db.Text

  createdAt     DateTime   @default(now())

  @@index([socialPostId])
  @@index([workspaceId])
  @@index([createdAt])
}

// ============================================================================
// AGENT SYSTEM
// ============================================================================

enum AgentType {
  STRATEGIST
  CONTENT_DIRECTOR
  CAMPAIGN_MANAGER
  REPORTING
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

enum SuggestionType {
  STRATEGY          // New campaign strategy
  CONTENT_SWAP      // Replace/refresh content
  BUDGET_CHANGE     // Increase/decrease budget
  AUDIENCE_SHIFT    // Change targeting
  PLATFORM_ADD      // Add new platform
  PLATFORM_PAUSE    // Pause underperforming platform
  CAMPAIGN_PAUSE    // Pause campaign
  CAMPAIGN_LAUNCH   // Launch new campaign
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
}

model AgentRun {
  id            String        @id @default(cuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agent         AgentType
  status        AgentRunStatus @default(RUNNING)
  triggeredBy   String?       // "cron", "user", "auto"

  inputData     Json?         // what the agent received
  outputData    Json?         // what the agent produced
  error         String?

  durationMs    Int?
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  suggestions   AgentSuggestion[]
  reports       AgentReport[]

  @@index([workspaceId])
  @@index([agent])
  @@index([status])
  @@index([createdAt])
}

model AgentSuggestion {
  id            String           @id @default(cuid())
  workspaceId   String
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentRunId    String?
  agentRun      AgentRun?        @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  agent         AgentType
  type          SuggestionType
  status        SuggestionStatus @default(PENDING)

  // Human-readable summary
  title         String           // "CTR dropped 22% — Swap audience"
  reasoning     String           @db.Text  // Why the agent recommends this
  impact        String?          // "Expected: +15% CTR"

  // Structured action payload (agent-type specific)
  payload       Json             // { action, params }

  // Optional campaign link
  campaignId    String?

  // Approval tracking
  approvedAt    DateTime?
  rejectedAt    DateTime?
  executedAt    DateTime?
  executionResult Json?

  // Urgency
  priority      Int @default(2)  // 1=urgent, 2=normal, 3=low
  expiresAt     DateTime?        // suggestion expires if not acted on

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([agent])
  @@index([priority])
  @@index([createdAt])
}

model AgentReport {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agentRunId    String?
  agentRun      AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  type          ReportType
  title         String       // "Weekly Performance — May 20–26"
  summary       String       @db.Text  // 2-3 sentence exec summary
  body          Json         // { metrics, insights, recommendations, highlights }

  // Period
  periodStart   DateTime
  periodEnd     DateTime

  // Optional campaign scope
  campaignId    String?

  // Email sent?
  emailedAt     DateTime?

  createdAt     DateTime     @default(now())

  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// VISUAL GENERATION
// ============================================================================

enum VisualStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  ARCHIVED
}

enum VisualType {
  HERO
  SOCIAL_PREVIEW
  AD_CREATIVE
  THUMBNAIL
  ALTERNATE
}

model GeneratedVisual {
  id              String       @id @default(cuid())

  // Ownership
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Visual configuration
  visualType      VisualType   @default(HERO)
  visualStyle     String       // Minimal, Luxury, Editorial, Cinematic, etc.
  prompt          String       @db.Text  // user-facing creative direction
  enhancedPrompt  String?      @db.Text  // full prompt sent to DALL-E

  // Campaign context snapshot (preserved at generation time)
  campaignName    String?
  campaignGoal    String?
  campaignTone    String?
  audience        String?      @db.Text

  // Brand context snapshot
  brandName       String?
  brandToneWords  String[]     @default([])

  // Generation state
  status          VisualStatus @default(PENDING)
  imageUrl        String?      // permanent Cloudinary URL
  thumbnailUrl    String?
  errorMessage    String?
  retryCount      Int          @default(0)

  // Metadata
  isPrimary       Boolean      @default(false)
  isArchived      Boolean      @default(false)
  version         Int          @default(1)
  parentId        String?      // links regenerations to original

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([workspaceId])
  @@index([campaignId])
  @@index([status])
}

// ============================================================================
// PAID CAMPAIGN PACK
// ============================================================================
// Stores everything needed to launch a paid campaign on any platform.
// Designed so the same data model maps 1:1 to Meta/Google/TikTok Marketing APIs
// — when API approvals arrive, we just add the API call on top of this model.

enum PaidPackStatus {
  DRAFT
  GENERATED
  LAUNCHED
  COMPLETED
}

enum PaidObjective {
  AWARENESS     // Brand awareness, reach
  TRAFFIC       // Link clicks, website visits
  CONVERSIONS   // Purchases, sign-ups, form fills
  LEADS         // Lead gen forms
  ENGAGEMENT    // Post engagement, video views
}

model PaidCampaignPack {
  id          String   @id @default(cuid())
  campaignId  String   @unique
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Campaign Setup
  objective        PaidObjective  @default(TRAFFIC)
  platforms        String[]       @default([])  // ["meta", "google", "tiktok", "linkedin"]
  dailyBudget      Float?         // USD
  totalBudget      Float?         // USD
  durationDays     Int            @default(7)
  startDate        DateTime?
  currency         String         @default("USD")

  // AI-Generated Content
  audienceBrief    Json?   // { meta: {...}, google: {...}, tiktok: {...}, linkedin: {...} }
  copyVariants     Json?   // [ { id, label, primaryText, headline, description, cta, platform } ]
  estimatedReach   Json?   // { meta: { min, max }, tiktok: { min, max }, ... }
  utmParams        Json?   // { source, medium, campaign, content, term, fullUrl }
  platformGuides   Json?   // { meta: [...steps], google: [...steps], tiktok: [...steps] }
  budgetInsights   Json?   // { recommendation, splitSuggestion, competitorBenchmark }

  // Selected Assets
  creativeAssetUrls String[] @default([])  // Cloudinary URLs from Media Library
  primaryCopyId     String?  // which copyVariant is currently selected

  // Status Tracking
  status           PaidPackStatus @default(DRAFT)
  launchedAt       DateTime?
  launchNotes      String?   @db.Text  // user notes when marking as launched
  completedAt      DateTime?

  // Performance (manually entered or GA4)
  metrics          Json?   // { impressions, reach, clicks, ctr, cpc, cpm, spend, conversions, roas }
  metricsSource    String? // "manual" | "ga4" | "meta_api"
  metricsUpdatedAt DateTime?

  // Brand Brain Learning
  learnings        Json?   // { winningHooks[], winningAudiences{}, bestPlatform, failedAngles[], insights }
  brandBrainUpdated Boolean @default(false)
  brandBrainUpdatedAt DateTime?

  generatedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId])
  @@index([campaignId])
  @@index([status])
}

// ============================================================================
// CAMPAIGN MEMORY — AI learning across campaigns
// ============================================================================

// Stores distilled learnings from each campaign's AI output.
// Retrieved before strategy generation so the AI can build on past wins.
// No pgvector needed at this stage — text-based retrieval is sufficient
// until we have enough data volume to justify vector similarity search.

model CampaignMemory {
  id           String    @id @default(cuid())

  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId   String?   // linked campaign (nullable — workspace-level memories exist too)

  // Campaign context (used for filtering relevant memories)
  goal         String?   // "sales" | "awareness" | "leads" | "traffic"
  tone         String?   // "luxury" | "modern" | "energetic" etc.
  industry     String?   // from brand profile
  audienceHint String?   // short description of the target audience

  // Distilled learnings extracted from the AI output
  // { topHooks, contentAngles, keyMessage, positioning, contentPillars, winningFormats }
  learnings    Json

  createdAt    DateTime  @default(now())

  @@index([workspaceId])
  @@index([workspaceId, goal])
  @@index([workspaceId, createdAt])
}

// ============================================================================
// BRAIN LEARNING — auto-extracted insights waiting for user review
// ============================================================================

model BrainLearning {
  id          String    @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId  String?   // source campaign (nullable for content-level triggers)

  // Learning metadata
  trigger     String    // 'strategy' | 'approved_content' | 'post_performance'
  field       String    // Brand Brain field: winningHooks | toneKeywords | uniqueAdvantages | etc.
  displayName String    // Human-readable: "Winning Hooks", "Brand Tone", etc.
  icon        String?   // emoji icon for the field

  // Values
  current     Json?     // current value in Brand Brain
  proposed    Json      // proposed new / merged value
  reason      String    @db.Text  // why NEXUS recommends this (shown to user)

  status      String    @default("pending")  // pending | accepted | dismissed

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model BrainScoreSnapshot {
  id          String    @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  score       Int       // 0–100 completeness score at time of save

  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ============================================================================
// BRAND BRAIN — execution-workflow learning events (Brand Brain Sprint PR1)
// ============================================================================
// Append-only WHAT-happened log of real execution actions (approve / schedule /
// manual-publish / unschedule / revert). This is the product LEARNING layer (vs
// PostStatusHistory, which is the lifecycle audit trail). A later sprint reads these
// to learn from the user's behaviour. PURELY ADDITIVE: ids are stored as plain
// strings (no relations, like PostStatusHistory.workspaceId) so this is a single new
// table touching no existing model. NEVER stores performance metrics or inferred
// results — only the action, its honest from/to status, and small safe metadata.
model MarketingLearningEvent {
  id            String   @id @default(cuid())

  workspaceId   String
  campaignId    String?
  socialPostId  String?

  eventType     String   // POST_APPROVED | POST_SCHEDULED | POST_MANUALLY_PUBLISHED | POST_UNSCHEDULED | POST_REVERTED_TO_DRAFT | POST_FAILED | POST_AUTO_PUBLISHED
  source        String   @default("EXECUTION_WORKFLOW")
  actor         String   @default("USER")   // USER | SYSTEM | CRON
  metadata      Json     @default("{}")

  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, eventType])
  @@index([socialPostId])
  @@index([campaignId])
}

// ============================================================================
// PAID ADVERTISING CAMPAIGNS — Full Ad Manager System
// ============================================================================
// Architecture:
//   AdAccount → AdCampaign → AdSet → Ad
//   AdPerformanceSnapshot (daily metrics synced per campaign/adset/ad)
//
// Designed 1:1 with Meta Marketing API v21, Google Ads API v17,
// TikTok Marketing API v1.3, LinkedIn Campaign Manager API v2.
// Platform IDs (platformCampaignId, platformAdSetId, platformAdId) are
// null until the campaign is pushed live — enabling "export mode" first,
// then "live API mode" without changing the data model.

enum AdPlatform {
  META        // Facebook + Instagram (Meta Marketing API)
  GOOGLE      // Google Ads: Search, Display, P-Max, YouTube
  TIKTOK      // TikTok Marketing API
  LINKEDIN    // LinkedIn Campaign Manager API
}

enum AdAccountStatus {
  ACTIVE
  DISCONNECTED
  ERROR
  PENDING
}

enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW    // submitted to platform, awaiting review
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  REJECTED          // platform rejected the campaign
}

enum AdObjective {
  BRAND_AWARENESS   // Reach people likely to remember your brand
  REACH             // Show ad to maximum unique people
  TRAFFIC           // Drive traffic to website, app, or WhatsApp
  ENGAGEMENT        // Post likes, page follows, video views
  APP_INSTALLS      // Drive app installs
  VIDEO_VIEWS       // Maximize video view time
  LEAD_GENERATION   // Lead Gen Forms / Google Lead Ads
  MESSAGES          // Start conversations on WhatsApp/Messenger
  CONVERSIONS       // Purchase, sign-up, add-to-cart
  CATALOG_SALES     // Dynamic product ads from catalog
  STORE_VISITS      // Drive in-store footfall
}

enum BidStrategy {
  LOWEST_COST          // Spend budget, minimize cost (default)
  COST_CAP             // Keep average cost at or below cap
  BID_CAP              // Max bid per auction
  TARGET_COST          // Maintain cost stability
  MINIMUM_ROAS         // Maintain minimum return on ad spend
  MANUAL_CPC           // Manual cost per click (Google)
  MANUAL_CPM           // Manual cost per thousand impressions
  MAXIMIZE_CONVERSIONS // Google: maximize conversion volume
  TARGET_CPA           // Google: target cost per acquisition
  TARGET_ROAS          // Google: target return on ad spend
}

enum AdFormat {
  SINGLE_IMAGE
  SINGLE_VIDEO
  CAROUSEL            // Multi-image/video swipeable (Meta, LinkedIn)
  COLLECTION          // Instant storefront (Meta)
  STORIES             // Vertical 9:16 stories
  REELS               // Instagram/Facebook Reels
  SEARCH              // Google text ad
  DISPLAY             // Google display banner
  PERFORMANCE_MAX     // Google P-Max (AI-driven all formats)
  RESPONSIVE_DISPLAY  // Google responsive display
  SPARK_ADS           // TikTok: boost organic content
  TOP_VIEW            // TikTok: full-screen on app open
  IN_FEED             // TikTok: in-feed ad
  SPONSORED_CONTENT   // LinkedIn: sponsored post
  MESSAGE_ADS         // LinkedIn: InMail / sponsored messaging
  LEAD_GEN_FORM       // Meta / LinkedIn: embedded lead form
  DYNAMIC             // Dynamic creative optimization
}

enum AdStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ARCHIVED
  DISAPPROVED
  COMPLETED
}

// Connected ad account (one per platform per workspace)
model AdAccount {
  id              String          @id @default(cuid())

  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform        AdPlatform
  status          AdAccountStatus @default(DISCONNECTED)

  // Platform identifiers
  platformAccountId   String      // Meta: "act_123456789" | Google: "123-456-7890" | TikTok: "7123456789"
  platformAccountName String?     // Human-readable name from the platform
  businessId          String?     // Meta Business Manager ID / Google MCC account ID
  businessName        String?

  // OAuth credentials
  accessToken     String?   @db.Text  // Platform access token (handle encryption at app layer)
  refreshToken    String?   @db.Text
  tokenExpiresAt  DateTime?

  // Account configuration
  currency        String    @default("USD")   // Account-level billing currency
  timeZone        String?   @default("UTC")   // Account timezone (e.g., "Asia/Dubai")
  country         String?

  // Verification status
  isVerified      Boolean   @default(false)   // Business verification complete
  hasApiAccess    Boolean   @default(false)   // API permission approved by platform
  permissionScopes String[] @default([])      // Granted OAuth scopes

  // Meta-specific
  pageId          String?   // Connected Facebook Page ID
  pageName        String?
  pixelId         String?   // Meta Pixel ID for conversion tracking
  instagramAccountId String? // Linked Instagram Business Account

  // Google-specific
  loginCustomerId String?   // MCC / manager account ID

  // Account health
  spendLimit      Float?    // Monthly spend cap (set by user in Nexus)
  totalSpent      Float     @default(0)   // Lifetime spend synced from platform
  lastSyncAt      DateTime?
  lastErrorAt     DateTime?
  lastError       String?

  // Relations
  adCampaigns     AdCampaign[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, platform, platformAccountId])
  @@index([workspaceId])
  @@index([platform])
  @@index([status])
}

// A paid advertising campaign (separate from organic Campaign)
model AdCampaign {
  id              String            @id @default(cuid())

  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  adAccountId     String?
  adAccount       AdAccount?        @relation(fields: [adAccountId], references: [id], onDelete: SetNull)

  // Optional cross-reference to the organic campaign that inspired this
  organicCampaignId String?

  // Platform
  platform        AdPlatform
  platformCampaignId String?        // Null until pushed to platform via API
  platformStatus  String?           // Status as reported by the platform API

  // Campaign config
  name            String
  objective       AdObjective       @default(TRAFFIC)
  status          AdCampaignStatus  @default(DRAFT)

  // Budget
  budgetType      String            @default("DAILY")  // "DAILY" | "LIFETIME"
  dailyBudget     Float?            // In account currency
  lifetimeBudget  Float?
  currency        String            @default("USD")

  // Schedule
  startDate       DateTime?
  endDate         DateTime?

  // Special flags
  isBoosted       Boolean           @default(false)   // Boosted post / Spark Ad
  isAbTest        Boolean           @default(false)   // A/B split test campaign

  // AI Intelligence (Brand Brain powered)
  // Generated by POST /api/ad-campaigns/[id]/generate-strategy
  aiStrategy      Json?
  // {
  //   positioning: string,
  //   targetingRationale: string,
  //   creativeBrief: string,
  //   messagingHierarchy: string[],
  //   expectedResults: string,
  //   competitorContext: string,
  //   recommendedBudgetSplit: Record<string, number>,
  // }

  aiAudienceBrief Json?             // Full audience brief per platform
  aiBudgetPlan    Json?             // { allocation, phasing, benchmarks, expectedReach }

  // Brand Brain snapshot at creation time (for reproducibility)
  brandBrainSnapshot Json?

  // UTM tracking
  utmSource       String?
  utmMedium       String?  @default("paid_social")
  utmCampaign     String?
  trackingUrls    Json?    // { platform: "full UTM URL" }

  // Denormalized performance totals (updated by cron / manual entry)
  totalImpressions  Int     @default(0)
  totalClicks       Int     @default(0)
  totalSpend        Float   @default(0)
  totalConversions  Int     @default(0)
  avgCTR            Float?
  avgCPC            Float?
  avgROAS           Float?

  // Sync state
  lastSyncAt      DateTime?
  lastSyncError   String?

  // Relations
  adSets          AdSet[]
  performanceSnapshots AdPerformanceSnapshot[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@index([adAccountId])
  @@index([platform])
  @@index([status])
  @@index([organicCampaignId])
  @@index([platformCampaignId])
  @@index([startDate])
}

// Ad Set / Ad Group — targeting + budget within a campaign
model AdSet {
  id              String     @id @default(cuid())

  adCampaignId    String
  adCampaign      AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)

  platformAdSetId String?    // Null until pushed to platform

  // Configuration
  name            String
  status          AdStatus   @default(DRAFT)

  // Budget (overrides campaign-level budget if set)
  dailyBudget     Float?
  lifetimeBudget  Float?
  bidStrategy     BidStrategy @default(LOWEST_COST)
  bidAmount       Float?      // Bid cap / cost cap value

  // Schedule
  startDate       DateTime?
  endDate         DateTime?

  // Targeting — JSON for maximum flexibility across platforms
  // Maps directly to Meta, Google, TikTok, LinkedIn API fields
  targeting       Json?
  // {
  //   ageMin: number,
  //   ageMax: number,
  //   genders: string[],        // ["male","female"] or ["all"]
  //   locations: {
  //     country?: string,        // ISO 2-letter code
  //     region?: string,
  //     city?: string,
  //     radius?: number,         // km
  //   }[],
  //   languages: string[],       // ISO language codes
  //
  //   // Meta interests & behaviors
  //   interests: { id?: string, name: string }[],
  //   behaviors: { id?: string, name: string }[],
  //   exclusions: { interests?: unknown[], customAudiences?: unknown[] },
  //
  //   // Custom / Lookalike audiences
  //   customAudiences: { id: string, name: string }[],
  //   lookalikeSources: { id: string, type: string, ratio?: number }[],
  //
  //   // Google
  //   keywords: { text: string, matchType: "BROAD"|"PHRASE"|"EXACT" }[],
  //   negativeKeywords: string[],
  //   audienceSegments: string[],
  //
  //   // LinkedIn
  //   jobTitles: string[],
  //   industries: string[],
  //   companySizes: string[],
  //   seniority: string[],
  //   skills: string[],
  //   memberGroups: string[],
  //
  //   // TikTok
  //   interestCategories: string[],
  //   deviceTypes: string[],
  //   networkTypes: string[],
  //
  //   // Size estimate
  //   audienceSizeMin: number,
  //   audienceSizeMax: number,
  // }

  // Placement configuration
  placements      Json?
  // {
  //   automatic: boolean,
  //   manual: string[],     // e.g. ["FACEBOOK_NEWSFEED", "INSTAGRAM_REELS", "INSTAGRAM_STORY"]
  //   devices: string[],    // ["MOBILE", "DESKTOP", "ALL"]
  //   operatingSystems: string[],  // ["ANDROID", "IOS", "ALL"]
  // }

  // Optimization
  optimizationGoal  String?  // "REACH" | "LINK_CLICKS" | "CONVERSIONS" | "LEAD_GENERATION"
  billingEvent      String?  // "IMPRESSIONS" | "LINK_CLICKS" | "THRUPLAY"

  // Denormalized performance totals
  totalImpressions  Int     @default(0)
  totalClicks       Int     @default(0)
  totalSpend        Float   @default(0)
  totalConversions  Int     @default(0)
  avgCTR            Float?

  // Relations
  ads             Ad[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([adCampaignId])
  @@index([status])
  @@index([platformAdSetId])
}

// Individual ad creative within an Ad Set
model Ad {
  id              String     @id @default(cuid())

  adSetId         String
  adSet           AdSet      @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  // Platform identifiers (set after API push)
  platformAdId    String?
  platformCreativeId String?

  // Configuration
  name            String
  status          AdStatus   @default(DRAFT)
  format          AdFormat   @default(SINGLE_IMAGE)

  // Copy fields
  primaryText     String?    @db.Text   // Main body / post text
  headline        String?               // Max 40 chars (Meta), 30 chars (Google RSA)
  description     String?               // Link preview description
  callToAction    String?               // "LEARN_MORE" | "SHOP_NOW" | "SIGN_UP" | "BOOK_NOW" | "CONTACT_US" | "GET_QUOTE"
  displayUrl      String?               // Google ads display path
  destinationUrl  String?               // Final URL with UTM params

  // Creative assets (Cloudinary URLs)
  imageUrl        String?
  videoUrl        String?
  thumbnailUrl    String?               // Video poster / cover image
  carouselCards   Json?                 // [{ imageUrl, headline, description, linkUrl, cta }]

  // Creative specs validation
  creativeSpecs   Json?    // { width, height, aspectRatio, duration, fileSize, format }
  specsValidated  Boolean  @default(false)
  specsErrors     String[] @default([])  // Human-readable validation errors

  // A/B testing
  variantGroup    String?  // Shared UUID linking variant ads in same group
  variantLabel    String?  // "A" | "B" | "C"
  isWinner        Boolean  @default(false)  // Marked after analysis

  // AI generation metadata
  aiGenerated     Boolean  @default(false)
  aiAngle         String?  // "pain_point" | "social_proof" | "curiosity" | "benefit" | "urgency"
  aiHook          String?  // The opening hook line
  generationPrompt String? @db.Text

  // Denormalized performance metrics (synced from snapshots)
  impressions     Int     @default(0)
  clicks          Int     @default(0)
  spend           Float   @default(0)
  conversions     Int     @default(0)
  ctr             Float?
  cpc             Float?
  cpm             Float?
  roas            Float?

  // Platform review
  reviewStatus    String?   // "PENDING" | "APPROVED" | "DISAPPROVED"
  reviewFeedback  String?   // Platform disapproval reason

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([adSetId])
  @@index([status])
  @@index([platformAdId])
  @@index([variantGroup])
}

// Daily performance snapshots per campaign / adset / ad
// Fetched from platform APIs via cron or entered manually
model AdPerformanceSnapshot {
  id              String     @id @default(cuid())

  adCampaignId    String
  adCampaign      AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)

  // Granularity (null = aggregate at that level)
  adSetId         String?    // null = campaign-level
  adId            String?    // null = adset-level

  // Date dimension (UTC — represents the calendar day)
  date            DateTime

  // Reach & exposure
  impressions     Int     @default(0)
  reach           Int     @default(0)   // Unique accounts reached
  frequency       Float?                // Avg impressions per unique user

  // Engagement
  clicks          Int     @default(0)
  linkClicks      Int     @default(0)   // Outbound clicks to destination URL
  videoViews      Int     @default(0)   // 3-second video views
  videoViewRate   Float?                // % who watched 25%+
  videoCompletions Int    @default(0)   // Watched 95%+ (ThruPlay)
  postEngagements Int     @default(0)   // Likes, comments, shares, saves

  // Conversions
  conversions     Int     @default(0)   // Total tracked conversions
  leads           Int     @default(0)
  purchases       Int     @default(0)
  addToCarts      Int     @default(0)
  registrations   Int     @default(0)

  // Cost metrics
  spend           Float   @default(0)   // Actual spend in account currency
  cpm             Float?                // Cost per 1,000 impressions
  cpc             Float?                // Cost per click
  ctr             Float?                // Click-through rate (%)
  cpa             Float?                // Cost per action / conversion
  roas            Float?                // Return on ad spend

  // Quality signals
  relevanceScore  Float?                // Meta relevance / Google quality score (1–10)

  // Data provenance
  dataSource      String  @default("api")   // "api" | "manual" | "estimated"
  syncedAt        DateTime @default(now())

  createdAt       DateTime @default(now())

  @@unique([adCampaignId, adSetId, adId, date])
  @@index([adCampaignId])
  @@index([adSetId])
  @@index([adId])
  @@index([date])
}

// ============================================================================
// META APP REVIEW COMPLIANCE
// ============================================================================

// Tracks Meta Data Deletion Requests (required by Meta Platform Policy)
// Endpoint: POST /api/social/callback/meta-data-deletion
model DataDeletionRequest {
  id              String   @id @default(cuid())

  // Meta's Facebook user ID (from signed_request payload)
  fbUserId        String

  // Our internal user ID (if we can match it)
  userId          String?

  // Deletion status
  status          String   @default("pending")   // "pending" | "completed" | "not_found"

  // Confirmation code returned to Meta
  confirmationCode String  @unique

  // Timestamp when Meta sent the request
  requestedAt     DateTime @default(now())

  // Timestamp when we completed the deletion
  completedAt     DateTime?

  @@index([fbUserId])
  @@index([userId])
  @@index([confirmationCode])
  @@index([status])
}

// ============================================================================
// RATE LIMITING (production-grade, cross-instance)
// ============================================================================

// Stores per-key sliding-window counters in Postgres.
// One row per rate-limit key (e.g. "ai:userId", "chat:userId", "checkout:userId").
// The API layer resets count when windowStart is older than the window duration.
// Run `npx prisma db push` after deploying to activate.
model RateLimitRecord {
  id          String   @id @default(cuid())
  key         String   @unique           // composite key: "scope:identifier"
  windowStart DateTime                   // start of the current window
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([updatedAt])
}
