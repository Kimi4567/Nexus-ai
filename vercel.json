{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/reconcile-social-publishing",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/refresh-social-tokens",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/reset-credits",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/expire-credits",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/generate-images",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/weekly-brief",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/nurture-emails",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/agent-monitor",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/check-integrations",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/fetch-analytics",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/competitor-monitor",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/trend-monitor",
      "schedule": "30 8 * * 1"
    },
    {
      "path": "/api/cron/refresh-ad-tokens",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "src/app/api/visuals/generate/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/campaigns/[id]/content-plan/[postId]/generate-video/route.ts": {
      "maxDuration": 180
    },
    "src/app/api/generate/preview/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/agents/run/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/autopilot/activate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/generate-images/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/publish/route.ts": {
      "maxDuration": 180
    },
    "src/app/api/social/publish/route.ts": {
      "maxDuration": 180
    },
    "src/app/api/cron/reconcile-social-publishing/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/refresh-social-tokens/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/campaigns/[id]/engine/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/campaigns/[id]/paid-pack/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/campaigns/[id]/paid-pack/learn/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/strategy/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/strategy/run-full/route.ts": {
      "maxDuration": 180
    },
    "src/app/api/campaigns/[id]/generate-content-plan/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/campaigns/[id]/generate-content-plan/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/campaigns/[id]/approve-content-plan/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/check-integrations/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/fetch-analytics/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/lifecycle-emails/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/competitor-monitor/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/trend-monitor/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/brand/scan-website/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/brand/analyze-content/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/brain/learn/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/brand/suggest/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/chat/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ai/generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/campaigns/suggest/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/campaigns/[id]/content-plan/[postId]/rewrite/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ad-campaigns/ai-suggest/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ad-campaigns/[id]/generate-strategy/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ad-campaigns/[id]/generate-copy/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/agent-monitor/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/weekly-brief/route.ts": {
      "maxDuration": 60
    }
  }
}
